{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchTranscript",
  "version": "0.5.0",
  "identifier": "city.bias.researchtranscript",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResearchTranscript",
        "url": "index.html",
        "width": 1100,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "resources": {
      "resources/python-runtime": "python-runtime",
      "resources/python": "python",
      "resources/bin": "bin",
      "resources/lib": "lib",
      "resources/models": "models",
      "resources/BUNDLED": "BUNDLED"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "A24B887F1B465B0F6767E8EF61FF12A00CAA66D1",
      "entitlements": "entitlements.plist",
      "frameworks": [
        "resources/python-runtime/lib/libpython3.13.dylib"
      ]
    }
  }
}
